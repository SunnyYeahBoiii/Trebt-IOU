generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions", "views"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  engineType      = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String      @id @unique @default(cuid())
  name              String
  billCreditorIn    Bill[]      @relation("billCreditor")
  creditorIn        Debt[]      @relation("creditor")
  debtorIn          Debt[]      @relation("debtor")
  statisticCreditor Statistic[] @relation("statisticCreditor")
  statisticDebtor   Statistic[] @relation("statisticDebtor")

  @@map("users")
}

model Debt {
  id         String @id @default(cuid())
  amount     Float
  creditorId String
  debtorId   String
  billId     String
  bill       Bill   @relation(fields: [billId], references: [id])
  creditor   User   @relation("creditor", fields: [creditorId], references: [id])
  debtor     User   @relation("debtor", fields: [debtorId], references: [id])

  @@unique([billId, debtorId])
  @@map("debts")
}

model Bill {
  id          String   @id @unique @default(cuid())
  description String?
  totalAmount Float
  billType    BillType
  debtorIDs   String
  creditorId  String
  creditor    User     @relation("billCreditor", fields: [creditorId], references: [id])
  debts       Debt[]

  @@map("bills")
}

model Statistic {
  id         String @id @default(cuid())
  totalLent  Float
  totalOwed  Float
  creditorId String
  debtorId   String
  creditor   User   @relation("statisticCreditor", fields: [creditorId], references: [id])
  debtor     User   @relation("statisticDebtor", fields: [debtorId], references: [id])

  @@unique([creditorId, debtorId])
  @@map("statistics")
}

enum BillType {
  EACHONE
  SPLITTING
}
