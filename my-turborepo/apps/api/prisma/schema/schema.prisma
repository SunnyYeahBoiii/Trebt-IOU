// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/prisma"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions", "views", "fullTextSearchPostgres"]
  engineType      = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id   String @id @unique @default(cuid())
  name String

  creditorIn        Debt[]      @relation("creditor")
  debtorIn          Debt[]      @relation("debtor")
  statisticCreditor Statistic[] @relation("statisticCreditor")
  statisticDebtor   Statistic[] @relation("statisticDebtor")
  billCreditorIn    Bill[]      @relation("billCreditor")

  @@map("users")
}

model Debt {
  id              String   @id @unique @default(cuid())
  amount          Float
  billId          String 
  bill            Bill @relation(fields: [billId], references: [id])

  creditorId      String
  creditor        User @relation("creditor" , fields: [creditorId], references: [id])
  debtorId        String
  debtor          User @relation("debtor" , fields: [debtorId], references: [id])

  @@map("debts")
}

model Bill{
  id              String @id @unique @default(cuid())
  description     String?
  totalAmount     Float
  billType        BillType
  debtorIDs       String
  creditorId      String
  creditor        User @relation("billCreditor" , fields: [creditorId], references: [id])
  debts           Debt[]
}

model Statistic {
  id         String @id @default(cuid())
  totalLent  Float
  totalOwed  Float
  creditorId String
  creditor   User   @relation("statisticCreditor", fields: [creditorId], references: [id])
  debtorId   String
  debtor     User   @relation("statisticDebtor", fields: [debtorId], references: [id])

  @@map("statistics")
  @@unique([creditorId, debtorId])
}

enum BillType {
  EACHONE
  SPLITTING
}
